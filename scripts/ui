#!/usr/bin/env python3
"""Real-UI test driver: drive Neovim inside tmux, inspect its screen.

See `ui-test-plan.md` §A.1 for the command set.
"""

import sys
from pathlib import Path

# Keep `build/` clean: no `__pycache__` next to the helpers.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

from ui_lib.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
