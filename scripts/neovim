#!/usr/bin/env python3
"""Start an interactive Neovim with this checkout's server and client.

This is the launcher behind `make neovim`. Unlike the test harnesses it starts a
real terminal editor: it loads only the dedicated `scripts/neovim_init.lua`
instead of a user configuration or the MiniTest initializer, and points
`$MAGIT_LSP_BIN` at the checkout's debug server. Neovim's config/data/state/
cache directories and every editor state write (shada, swap, backup, undo and
view files) go to a temporary directory that is removed when the editor exits.

`HOME` and the terminal environment are inherited so Git and external helpers
keep the caller's normal global configuration. Because `XDG_CONFIG_HOME` is
redirected for Neovim, a temporary include-only `GIT_CONFIG_GLOBAL` replays the
caller's original XDG `git/config` and `~/.gitconfig`; an explicit
`GIT_CONFIG_GLOBAL` is never replaced.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Callable, Mapping, Sequence
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INIT = Path(__file__).resolve().with_name("neovim_init.lua")
SERVER = ROOT / "target" / "debug" / "magit-lsp"
CLIENT_RUNTIME = ROOT / "clients" / "neovim"

# Relative to the run directory created for one launch.
ISOLATED_DIRECTORIES = (
    "config",
    "data",
    "state",
    "cache",
    "runtime",
    "shada",
    "swap",
    "backup",
    "undo",
    "view",
)

# Include-only global Git config written for one launch when the caller has not
# already supplied `GIT_CONFIG_GLOBAL`.
GIT_GLOBAL_CONFIG = "gitconfig"


class LauncherError(RuntimeError):
    """A launcher problem reported to the user without a traceback."""


def repository(
    path: str | os.PathLike[str] | None,
    cwd: str | os.PathLike[str] | None = None,
) -> Path:
    """Resolve the repository to open, defaulting to the working directory."""
    selected = path if path is not None and str(path) != "" else cwd
    return Path(os.getcwd() if selected is None else selected).expanduser().resolve()


def validate(
    repo: Path,
    *,
    server: Path = SERVER,
    init: Path = INIT,
    runtime: Path = CLIENT_RUNTIME,
) -> None:
    """Reject a missing repository, server, initializer or client runtime."""
    if not repo.is_dir():
        raise LauncherError(f"repository is not a directory: {repo}")
    if not init.is_file():
        raise LauncherError(f"launcher initializer is missing: {init}")
    if not runtime.is_dir():
        raise LauncherError(f"client runtime is missing: {runtime}")
    if not os.access(server, os.X_OK):
        raise LauncherError(
            f"server binary is not executable: {server}\n"
            "Build it with `make build` before launching."
        )


def _config_path(value: str, *, home: str | None, repo: Path) -> Path:
    """Resolve an environment-supplied config path the way Git would see it."""
    if value == "~" or value.startswith("~/"):
        if home:
            value = home + value[1:]
    path = Path(os.path.expanduser(value))
    return path if path.is_absolute() else repo / path


def _global_git_config_sources(
    environment: Mapping[str, str], repo: Path
) -> list[Path]:
    """Return the caller's global Git config files in Git's precedence order.

    Git reads the XDG `git/config` file before `$HOME/.gitconfig`, falling back
    to `$HOME/.config/git/config` when `XDG_CONFIG_HOME` is unset.
    """
    home = environment.get("HOME")
    xdg = environment.get("XDG_CONFIG_HOME")
    if not xdg and home:
        xdg = str(Path(home) / ".config")
    sources = []
    if xdg:
        sources.append(_config_path(xdg, home=home, repo=repo) / "git" / "config")
    if home:
        sources.append(_config_path(home, home=home, repo=repo) / ".gitconfig")
    return sources


def _write_global_git_config(
    base: Path, *, environment: Mapping[str, str], repo: Path
) -> Path:
    """Write an include-only global config for the caller's original files.

    Git reads `$GIT_CONFIG_GLOBAL` instead of its default XDG/HOME lookup, so
    these includes reproduce that order while leaving the original files, their
    own `include`/`includeIf` sections and HOME-relative paths untouched. No
    configuration values are copied out of the caller's files.
    """
    path = base / GIT_GLOBAL_CONFIG
    lines = ["# Generated by scripts/neovim; removed when Neovim exits."]
    for source in _global_git_config_sources(environment, repo):
        quoted = str(source).replace("\\", "\\\\").replace('"', '\\"')
        lines.extend(["[include]", f'\tpath = "{quoted}"'])
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


def isolated_environment(
    base: Path,
    *,
    repo: Path,
    server: Path,
    inherited: Mapping[str, str] | None = None,
) -> dict[str, str]:
    """Create the per-run directories and return an isolated editor environment.

    The caller's `HOME` is preserved so Git and external helpers keep their
    normal user configuration. Neovim's XDG directories are redirected into
    `base`, and a temporary include-only `GIT_CONFIG_GLOBAL` keeps the original
    XDG and HOME global Git configuration visible in Git's precedence order.
    A caller-supplied `GIT_CONFIG_GLOBAL` is left untouched. `PATH` and terminal
    variables are inherited unchanged.
    """
    for name in ISOLATED_DIRECTORIES:
        (base / name).mkdir(parents=True, exist_ok=True)
    (base / "runtime").chmod(0o700)
    environment = dict(os.environ if inherited is None else inherited)
    if "GIT_CONFIG_GLOBAL" not in environment and _global_git_config_sources(
        environment, repo
    ):
        environment["GIT_CONFIG_GLOBAL"] = str(
            _write_global_git_config(base, environment=environment, repo=repo)
        )
    environment.update(
        {
            "XDG_CONFIG_HOME": str(base / "config"),
            "XDG_DATA_HOME": str(base / "data"),
            "XDG_STATE_HOME": str(base / "state"),
            "XDG_CACHE_HOME": str(base / "cache"),
            "XDG_RUNTIME_DIR": str(base / "runtime"),
            "MAGIT_LSP_BIN": str(server),
            "MAGIT_LSP_LAUNCH_REPO": str(repo),
            "MAGIT_LSP_LAUNCH_DIR": str(base),
        }
    )
    return environment


def command(nvim: str, *, init: Path = INIT, base: Path) -> list[str]:
    """Build the Neovim argv as discrete items so spaces need no escaping.

    `-i` names a ShaDa file inside the isolated `shada` directory, which
    `isolated_environment` creates: Neovim rejects a directory there.
    """
    return [
        nvim,
        "--noplugin",
        "-u",
        str(init),
        "-i",
        str(base / "shada" / "main.shada"),
    ]


def launch(
    repo: str | os.PathLike[str] | None,
    *,
    cwd: str | os.PathLike[str] | None = None,
    nvim: str | None = None,
    server: Path = SERVER,
    init: Path = INIT,
    runtime: Path = CLIENT_RUNTIME,
    runner: Callable[..., object] = subprocess.run,
    inherited: Mapping[str, str] | None = None,
    temporary_root: Path | None = None,
) -> int:
    """Run Neovim attached to the terminal and return its exit status.

    `runner` is the process adapter (default `subprocess.run`) and
    `temporary_root` is the parent for the isolated directories; tests replace
    both. The temporary directory is removed after the editor exits or fails.
    """
    repo_path = repository(repo, cwd)
    validate(repo_path, server=server, init=init, runtime=runtime)
    editor = nvim or shutil.which("nvim") or "nvim"
    base = Path(tempfile.mkdtemp(prefix="magit-neovim-", dir=temporary_root))
    try:
        environment = isolated_environment(
            base, repo=repo_path, server=Path(server).resolve(), inherited=inherited
        )
        result = runner(
            command(editor, init=init, base=base),
            env=environment,
            cwd=str(repo_path),
        )
        return int(getattr(result, "returncode", result))
    finally:
        shutil.rmtree(base, ignore_errors=True)


def main(argv: Sequence[str] | None = None) -> int:
    """Parse launcher arguments and report failures as one-line messages."""
    parser = argparse.ArgumentParser(
        description="Open an interactive Neovim with this checkout's magit-lsp client."
    )
    parser.add_argument(
        "--repo",
        default=None,
        help="repository to open (default: the current working directory)",
    )
    parser.add_argument(
        "--nvim",
        default=None,
        help="Neovim executable to run (default: nvim on PATH)",
    )
    args = parser.parse_args(argv)
    try:
        return launch(args.repo, nvim=args.nvim)
    except LauncherError as error:
        print(f"neovim launcher: {error}", file=sys.stderr)
        return 2
    except OSError as error:
        print(f"neovim launcher: cannot start Neovim: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
