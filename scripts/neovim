#!/usr/bin/env python3
"""Start an interactive Neovim with this checkout's server and client.

This is the launcher behind `make neovim`. Unlike the test harnesses it starts a
real terminal editor: it loads only the dedicated `scripts/neovim_init.lua`
instead of a user configuration or the MiniTest initializer, points
`$MAGIT_LSP_BIN` at the checkout's debug server and sends every editor state
write (HOME, XDG, shada, swap, backup, undo and view files) to a temporary
directory that is removed when the editor exits.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Callable, Mapping, Sequence
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INIT = Path(__file__).resolve().with_name("neovim_init.lua")
SERVER = ROOT / "target" / "debug" / "magit-lsp"
CLIENT_RUNTIME = ROOT / "clients" / "neovim"

# Relative to the run directory created for one launch.
ISOLATED_DIRECTORIES = (
    "home",
    "config",
    "data",
    "state",
    "cache",
    "runtime",
    "shada",
    "swap",
    "backup",
    "undo",
    "view",
)


class LauncherError(RuntimeError):
    """A launcher problem reported to the user without a traceback."""


def repository(
    path: str | os.PathLike[str] | None,
    cwd: str | os.PathLike[str] | None = None,
) -> Path:
    """Resolve the repository to open, defaulting to the working directory."""
    selected = path if path is not None and str(path) != "" else cwd
    return Path(os.getcwd() if selected is None else selected).expanduser().resolve()


def validate(
    repo: Path,
    *,
    server: Path = SERVER,
    init: Path = INIT,
    runtime: Path = CLIENT_RUNTIME,
) -> None:
    """Reject a missing repository, server, initializer or client runtime."""
    if not repo.is_dir():
        raise LauncherError(f"repository is not a directory: {repo}")
    if not init.is_file():
        raise LauncherError(f"launcher initializer is missing: {init}")
    if not runtime.is_dir():
        raise LauncherError(f"client runtime is missing: {runtime}")
    if not os.access(server, os.X_OK):
        raise LauncherError(
            f"server binary is not executable: {server}\n"
            "Build it with `make build` before launching."
        )


def isolated_environment(
    base: Path,
    *,
    repo: Path,
    server: Path,
    inherited: Mapping[str, str] | None = None,
) -> dict[str, str]:
    """Create the per-run directories and return an isolated editor environment.

    `PATH` and terminal variables are inherited unchanged so the editor keeps
    its normal shell and terminal behavior.
    """
    for name in ISOLATED_DIRECTORIES:
        (base / name).mkdir(parents=True, exist_ok=True)
    (base / "runtime").chmod(0o700)
    environment = dict(os.environ if inherited is None else inherited)
    environment.update(
        {
            "HOME": str(base / "home"),
            "XDG_CONFIG_HOME": str(base / "config"),
            "XDG_DATA_HOME": str(base / "data"),
            "XDG_STATE_HOME": str(base / "state"),
            "XDG_CACHE_HOME": str(base / "cache"),
            "XDG_RUNTIME_DIR": str(base / "runtime"),
            "MAGIT_LSP_BIN": str(server),
            "MAGIT_LSP_LAUNCH_REPO": str(repo),
            "MAGIT_LSP_LAUNCH_DIR": str(base),
        }
    )
    return environment


def command(nvim: str, *, init: Path = INIT, base: Path) -> list[str]:
    """Build the Neovim argv as discrete items so spaces need no escaping."""
    return [
        nvim,
        "--noplugin",
        "-u",
        str(init),
        "-i",
        str(base / "shada"),
    ]


def launch(
    repo: str | os.PathLike[str] | None,
    *,
    cwd: str | os.PathLike[str] | None = None,
    nvim: str | None = None,
    server: Path = SERVER,
    init: Path = INIT,
    runtime: Path = CLIENT_RUNTIME,
    runner: Callable[..., object] = subprocess.run,
    inherited: Mapping[str, str] | None = None,
    temporary_root: Path | None = None,
) -> int:
    """Run Neovim attached to the terminal and return its exit status.

    `runner` is the process adapter (default `subprocess.run`) and
    `temporary_root` is the parent for the isolated directories; tests replace
    both. The temporary directory is removed after the editor exits or fails.
    """
    repo_path = repository(repo, cwd)
    validate(repo_path, server=server, init=init, runtime=runtime)
    editor = nvim or shutil.which("nvim") or "nvim"
    base = Path(tempfile.mkdtemp(prefix="magit-neovim-", dir=temporary_root))
    try:
        environment = isolated_environment(
            base, repo=repo_path, server=Path(server).resolve(), inherited=inherited
        )
        result = runner(
            command(editor, init=init, base=base),
            env=environment,
            cwd=str(repo_path),
        )
        return int(getattr(result, "returncode", result))
    finally:
        shutil.rmtree(base, ignore_errors=True)


def main(argv: Sequence[str] | None = None) -> int:
    """Parse launcher arguments and report failures as one-line messages."""
    parser = argparse.ArgumentParser(
        description="Open an interactive Neovim with this checkout's magit-lsp client."
    )
    parser.add_argument(
        "--repo",
        default=None,
        help="repository to open (default: the current working directory)",
    )
    parser.add_argument(
        "--nvim",
        default=None,
        help="Neovim executable to run (default: nvim on PATH)",
    )
    args = parser.parse_args(argv)
    try:
        return launch(args.repo, nvim=args.nvim)
    except LauncherError as error:
        print(f"neovim launcher: {error}", file=sys.stderr)
        return 2
    except OSError as error:
        print(f"neovim launcher: cannot start Neovim: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
