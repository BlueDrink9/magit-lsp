# Managed editor-active cancellation uses the actual work-done token, not close.
fixture: staged-one-file
---
sh: git rev-parse HEAD > .git/cancel-before; git write-tree > .git/cancel-index; git hash-object f.txt > .git/cancel-worktree
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
snapshot: editor-active
keys: i "Never submitted"
keys: Escape
keys: ":lua local v=assert(require('magit-lsp.view').current()); assert(v.uri:match('COMMIT_EDITMSG$') and vim.bo[v.buf].buftype==''); local t; for token,p in pairs(require('magit-lsp.debug').state.progress) do if p.title=='Git' and p.message=='commit' then assert(not t); t=token end end; assert(t); assert(vim.lsp.get_client_by_id(v.client_id):notify('window/workDoneProgress/cancel',{token=t}))" Enter
wait screen contains "git commit"
snapshot: cancellation-feedback
sh: session=$(python3 -c 'import json; print(json.load(open("../state.json"))["tmux"])'); if tmux -L "$session" capture-pane -p -t magit | grep -Fq 'Press ENTER or type command to continue'; then tmux -L "$session" send-keys -t magit Enter; fi
wait
expect screen not-contains "Committing"
expect screen contains "Staged changes (1)"
snapshot: cancelled
sh: test "$(git rev-parse HEAD)" = "$(cat .git/cancel-before)" && test "$(git write-tree)" = "$(cat .git/cancel-index)" && test "$(git hash-object f.txt)" = "$(cat .git/cancel-worktree)"
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: i "After progress cancellation"
keys: Escape
keys standard: C-Enter
keys vim: Z Z
wait screen contains "Committed"
wait
expect screen contains "Staged changes (0)"
expect screen not-contains "Committing"
snapshot: next-commit
sh: test "$(git log -1 --format=%s)" = 'After progress cancellation'
expect no_message /E5108|Error executing lua|unexpected draft/
