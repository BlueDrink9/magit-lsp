# Confirm fixup against a non-HEAD commit; retain staged content and caller.
fixture: log-history
---
sh: printf '\nfixup staged sentinel\n' >> f.txt && git add f.txt && git rev-parse HEAD > .git/fixup-head && git rev-parse HEAD~2 > .git/fixup-target && git show -s --format=%s HEAD~2 > .git/fixup-target-subject && git write-tree > .git/fixup-index
keys: c
wait screen contains "Fixup"
keys: f
wait screen contains "Select commit"
snapshot: fixup-picker
keys: / "old searchable subject" Enter
wait
expect screen not-contains "Pattern not found"
keys: Enter
wait
expect screen contains "Unstaged changes"
expect view_stack.count == 1
snapshot: caller-restored
sh: test "$(git rev-parse HEAD^)" = "$(cat .git/fixup-head)" && test "$(git show -s --format=%s HEAD)" = "fixup! $(cat .git/fixup-target-subject)" && test "$(git rev-parse HEAD^{tree})" = "$(cat .git/fixup-index)" && test "$(git show HEAD:f.txt | tail -n 1)" = "fixup staged sentinel" && test "$(git status --porcelain)" = ""
