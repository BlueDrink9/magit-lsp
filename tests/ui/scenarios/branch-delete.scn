# Early T043: deleting a side branch from the status branch menu leaves HEAD alone.
fixture: modified-two-files
---
wait screen contains "+line3 CHANGED"
sh: git branch feature
keys: b
wait
expect screen contains "delete"
snapshot: branch-menu
keys: k
wait prompt
# The prompt pre-fills the current branch; clear it before naming the target.
keys: C-u feature Enter
wait
expect screen contains "Deleted branch feature"
sh: test -z "$(git for-each-ref --format='%(refname:short)' refs/heads/feature)"
sh: test "$(git rev-parse --abbrev-ref HEAD)" = main
snapshot: deleted
