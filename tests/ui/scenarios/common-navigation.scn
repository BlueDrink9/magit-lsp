# Hierarchy and visibility are resolved by the live server, not editor folds.
fixture: modified-two-files
profile: vim
profile-only: true
---
wait
goto "M f.txt"
keys: g j
wait
expect cursor on "  M g.txt"
keys: g j
wait
expect cursor on "  M g.txt"
keys: g k
wait
expect cursor on "  M f.txt"
goto "+line3 CHANGED"
keys: g u
wait
expect cursor on "  M f.txt"
keys: g u
wait
expect cursor on "Unstaged changes (2)"
snapshot: hierarchy
keys: shift+Tab
wait
expect screen not-contains "M f.txt"
expect cursor on "Unstaged changes (2)"
snapshot: sections-only
keys: shift+Tab
wait
expect screen contains "M f.txt"
expect screen not-contains "@@"
goto "M f.txt"
keys: g j
wait
expect cursor on "  M g.txt"
keys: g k
wait
expect cursor on "  M f.txt"
snapshot: folded-siblings
keys: shift+Tab
wait
expect screen contains "@@"
expect screen not-contains "+line3 CHANGED"
snapshot: hunk-headers
keys: shift+Tab
wait
expect screen contains "+line3 CHANGED"
snapshot: expanded
