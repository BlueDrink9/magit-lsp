# Early T043/branch-create: creating a branch prompts for a starting point,
# then the name, and leaves HEAD where it was.
fixture: modified-two-files
---
sh: git commit -am second && git rev-parse HEAD~1 > .git/create-target
keys: b
wait
expect screen contains "new branch"
snapshot: branch-menu
keys: n
wait prompt
expect screen contains "Starting point"
keys: HEAD~1 Enter
wait prompt
expect screen contains "Create branch"
keys: feature Enter
wait
expect screen contains "Created branch feature"
sh: test "$(git rev-parse feature)" = "$(cat .git/create-target)" && test "$(git rev-parse feature)" != "$(git rev-parse HEAD)" && test "$(git rev-parse --abbrev-ref HEAD)" = main
snapshot: created
