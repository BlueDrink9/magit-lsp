# A generic main view and a bottom view share the descriptor-driven manager.
# Closing nested views preserves the original status view and its live state.
fixture: modified-two-files
---
wait
expect view_stack.count == 1
snapshot: initial-status
keys standard: $
keys vim: g $
wait screen contains "Process log"
expect view_stack.count == 2
snapshot: main-view
keys standard: ?
keys vim: g ?
wait screen contains "Transient and dwim commands"
expect view_stack.count == 3
expect windows.floating == 1
snapshot: main-and-menu
keys: q
wait
expect screen contains "Process log"
expect view_stack.count == 2
expect windows.floating == 0
snapshot: main-after-menu
keys: q
wait
expect screen contains "Unstaged changes (2)"
expect view_stack.count == 1
keys standard: g
keys vim: g r
wait
expect screen contains "Unstaged changes (2)"
keys: c
wait screen contains "Commit"
expect windows.floating == 1
keys: q
wait
expect windows.floating == 0
expect screen contains "Unstaged changes (2)"
snapshot: live-status
