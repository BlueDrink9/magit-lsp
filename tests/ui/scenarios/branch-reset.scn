# Early T070: resetting a branch force-moves it without checking it out.
fixture: modified-two-files
---
sh: git branch feature
keys: b
wait
expect screen contains "reset"
snapshot: branch-menu
keys: x
wait prompt
expect screen contains "Reset branch"
keys: feature Enter
wait prompt
expect screen contains "Reset to"
keys: HEAD Enter
wait
expect screen contains "Reset branch feature to HEAD"
sh: test "$(git rev-parse feature)" = "$(git rev-parse HEAD)"
sh: test "$(git rev-parse --abbrev-ref HEAD)" = main
snapshot: reset
