# Bug 1: `?` must open the dispatch from a fresh status view under both
# profiles. The `h` alias is standard-only (`help-from-status-h.scn`) because
# `h` stays a motion in the vim profile (rule R4).
fixture: modified-two-files
---
keys: ?
wait
expect screen contains "Transient and dwim commands"
snapshot: dispatch
keys: Escape
wait
expect screen contains "Unstaged changes"
