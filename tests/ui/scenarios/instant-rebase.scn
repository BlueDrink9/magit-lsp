# Fold staged content into selected non-root commit through native instant fixup.
fixture: instant-rebase-history
---
wait screen contains "+staged sentinel"
sh: git rev-parse HEAD~3 > .git/base && git rev-parse HEAD~2 > .git/one && git rev-parse HEAD~1 > .git/target && git rev-parse HEAD > .git/head-before && git write-tree > .git/index-before && git branch --show-current > .git/branch-before
keys: c
wait screen contains "Fixup"
keys: F
wait screen contains "Select commit"
sh: nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "luaeval('vim.json.encode({mode=vim.api.nvim_get_mode().mode,name=vim.api.nvim_buf_get_name(0),cursor=vim.api.nvim_win_get_cursor(0)})')" > .git/selector-state && grep -q 'magit://log/v1:log' .git/selector-state && grep -q '"mode":"n"' .git/selector-state
sh: test "$(nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "line('.')")" = 3 && nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "getline('.')" | grep -q 'three'
keys: Down
wait
sh: test "$(nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "line('.')")" = 4 && nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "getline('.')" | grep -q 'two'
keys: Enter
wait screen contains "Staged changes (0)"
expect view_stack.count == 1
sh: git log --format=%s --reverse "$(cat .git/base)..HEAD" > .git/history && printf 'one\ntwo\nthree\n' > .git/history-expected && cmp .git/history-expected .git/history
sh: test "$(git rev-parse HEAD~3)" = "$(cat .git/base)"
sh: test "$(git rev-parse HEAD~2)" = "$(cat .git/one)" && test "$(git rev-parse HEAD~1)" != "$(cat .git/target)" && test "$(git rev-parse HEAD)" != "$(cat .git/head-before)"
sh: test "$(git show -s --format=%s HEAD~2)" = "one" && test "$(git show -s --format=%s HEAD~1)" = "two" && test "$(git show -s --format=%s HEAD)" = "three"
sh: test "$(git show HEAD~1:two)" = "$(printf 'two\nstaged sentinel')" && test "$(git show HEAD:two)" = "$(printf 'two\nstaged sentinel')"
sh: test "$(git write-tree)" = "$(cat .git/index-before)" && test "$(git write-tree)" = "$(git rev-parse HEAD^{tree})" && test -z "$(git status --porcelain)" && test "$(git branch --show-current)" = "$(cat .git/branch-before)"
sh: test ! -d .git/rebase-merge && test ! -d .git/rebase-apply
sh: git rev-parse HEAD > .git/after-head && git write-tree > .git/after-index && git branch --show-current > .git/after-branch && git log --format='%H %s' -3 > .git/after-history
keys: r
wait
expect view_stack.menus == 1
keys: Escape
wait screen contains "Unstaged changes"
expect view_stack.count == 1
sh: test "$(git rev-parse HEAD)" = "$(cat .git/after-head)" && test "$(git write-tree)" = "$(cat .git/after-index)" && test "$(git branch --show-current)" = "$(cat .git/after-branch)" && git log --format='%H %s' -3 > .git/after-history-check && cmp .git/after-history .git/after-history-check && test -z "$(git status --porcelain)" && test ! -d .git/rebase-merge && test ! -d .git/rebase-apply
# Fresh staged change: native instant squash edits the selected target message.
sh: printf '\nsquash-confirmed\n' >> two && git add two && git rev-parse HEAD > .git/squash-head-before && git write-tree > .git/squash-index-before && git hash-object two > .git/squash-worktree-before && git branch --show-current > .git/squash-branch-before
keys: c
wait screen contains "Squash"
keys: S
wait screen contains "Select commit"
sh: test "$(nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "line('.')")" = 3 && nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "getline('.')" | grep -q 'three'
keys: Down
wait
keys: Enter
wait screen contains "Please enter the commit message"
keys: g g d G i "Native squash message"
keys: Escape
keys standard: C-Enter
keys vim: Z Z
wait
wait screen contains "Instant autosquash completed"
wait screen contains "Staged changes (0)"
expect view_stack.count == 1
sh: test "$(git show -s --format=%s HEAD~1)" = "Native squash message"
sh: git log --format=%s --reverse "$(cat .git/base)..HEAD" > .git/squash-history && printf 'one\nNative squash message\nthree\n' > .git/squash-history-expected && cmp .git/squash-history-expected .git/squash-history
sh: test "$(git rev-parse HEAD~3)" = "$(cat .git/base)" && test "$(git rev-parse HEAD~2)" = "$(cat .git/one)" && test "$(git rev-parse HEAD~1)" != "$(cat .git/target)" && test "$(git rev-parse HEAD)" != "$(cat .git/head-before)"
sh: test "$(git show HEAD~1:two)" = "$(printf 'two\nstaged sentinel\n\nsquash-confirmed')" && test "$(git show HEAD:two)" = "$(printf 'two\nstaged sentinel\n\nsquash-confirmed')"
sh: test "$(git write-tree)" = "$(git rev-parse HEAD^{tree})" || { echo 'FAIL: index tree differs from HEAD tree'; exit 1; }; test -z "$(git status --porcelain)" || { echo 'FAIL: worktree/index is not clean'; exit 1; }; test ! -d .git/rebase-merge || { echo 'FAIL: rebase-merge state remains'; exit 1; }; test ! -d .git/rebase-apply || { echo 'FAIL: rebase-apply state remains'; exit 1; }
# Fresh staged content: native squash cancellation preserves its actual marker/rebase state.
sh: printf '\nsquash-cancelled\n' >> two && git add two && git rev-parse HEAD > .git/cancel-head-before && git write-tree > .git/cancel-index-before && git hash-object two > .git/cancel-worktree-before && git branch --show-current > .git/cancel-branch-before && git rev-parse "refs/heads/$(cat .git/cancel-branch-before)" > .git/cancel-ref-before
keys: c
wait screen contains "Squash"
keys: S
wait screen contains "Select commit"
keys: Down
wait
keys: Enter
wait screen contains "Please enter the commit message"
sh: nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "luaeval('(function() local function maps(mode) local out={} for _,m in ipairs(vim.api.nvim_buf_get_keymap(0,mode)) do out[#out+1]={lhs=m.lhs,desc=m.desc} end return out end return vim.json.encode({mode=vim.api.nvim_get_mode().mode,name=vim.api.nvim_buf_get_name(0),uri=require(\"magit-lsp.view\").current().uri,base=require(\"magit-lsp.view\").current().base,stack=#require(\"magit-lsp.view\").order,normal=maps(\"n\"),insert=maps(\"i\")}) end)()')" > .git/cancel-editor-before && grep -q '"mode":"n"' .git/cancel-editor-before && grep -q 'COMMIT_EDITMSG' .git/cancel-editor-before && grep -q 'Cancel' .git/cancel-editor-before
sh: git rev-parse "refs/heads/$(cat .git/cancel-branch-before)" > .git/cancel-marker-open && git rev-parse HEAD > .git/cancel-head-open && git ls-files --stage > .git/cancel-index-open && git hash-object two > .git/cancel-worktree-open && (git symbolic-ref --quiet --short HEAD || true) > .git/cancel-branch-open && test -d .git/rebase-merge
keys standard: C-S-x
keys vim: Z Q
wait screen contains "Instant autosquash stopped during autosquash"
expect view_stack.count == 1
sh: nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "luaeval('vim.json.encode({uri=require(\"magit-lsp.view\").current().uri,stack=#require(\"magit-lsp.view\").order,documents=(function() local n=0; for _,v in pairs(require(\"magit-lsp.view\").views) do if v.document then n=n+1 end end; return n end)()})')" > .git/cancel-editor-after && cat .git/cancel-editor-before .git/cancel-editor-after
sh: git rev-parse "refs/heads/$(cat .git/cancel-branch-before)" > .git/cancel-marker && git rev-parse HEAD > .git/cancel-stopped-head && git ls-files --stage > .git/cancel-stopped-index && git hash-object two > .git/cancel-stopped-worktree && (git symbolic-ref --quiet --short HEAD || true) > .git/cancel-stopped-branch && cmp .git/cancel-marker-open .git/cancel-marker && test "$(cat .git/cancel-marker)" != "$(cat .git/cancel-ref-before)" && test "$(git rev-parse "$(cat .git/cancel-marker)^")" = "$(cat .git/cancel-ref-before)" && cmp .git/cancel-head-open .git/cancel-stopped-head && cmp .git/cancel-index-open .git/cancel-stopped-index && cmp .git/cancel-worktree-open .git/cancel-stopped-worktree && cmp .git/cancel-branch-open .git/cancel-stopped-branch && test -d .git/rebase-merge
sh: git status --porcelain > .git/cancel-status
keys: r
wait
expect view_stack.menus == 1
keys: a
wait screen contains "Unstaged changes"
expect view_stack.count == 1
sh: test "$(git rev-parse HEAD)" = "$(cat .git/cancel-marker)" && test "$(git rev-parse "refs/heads/$(cat .git/cancel-branch-before)")" = "$(cat .git/cancel-marker)" && test "$(git write-tree)" = "$(git rev-parse "$(cat .git/cancel-marker)^{tree}")" && test "$(git hash-object two)" = "$(cat .git/cancel-stopped-worktree)" && test "$(git branch --show-current)" = "$(cat .git/cancel-branch-before)" && test -z "$(git status --porcelain)" && test ! -d .git/rebase-merge && test ! -d .git/rebase-apply
keys: r
wait
expect view_stack.menus == 1
keys: Escape
wait screen contains "Unstaged changes"
expect view_stack.count == 1
sh: test "$(git rev-parse HEAD)" = "$(cat .git/cancel-marker)" && test "$(git write-tree)" = "$(git rev-parse "$(cat .git/cancel-marker)^{tree}")" && test "$(git hash-object two)" = "$(cat .git/cancel-stopped-worktree)" && test -z "$(git status --porcelain)" && test ! -d .git/rebase-merge && test ! -d .git/rebase-apply
