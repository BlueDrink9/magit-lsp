# A10: a trusted repository binding reaches the real dynamic client.
fixture: modified-two-files
profile: vim
profile-only: true
env: MAGIT_LSP_CONFIG=.magit-lsp-user.toml
---
wait
expect screen contains "Unstaged changes (2)"
sh: printf 'trust_repo_config = true\n' > .magit-lsp-user.toml; printf '[keys.status]\nstage = ["Z"]\n' > .magit-lsp.toml; nvim --headless --server ../nvim.sock --remote-expr "luaeval('(function() for _,v in pairs(require(\"magit-lsp.view\").views) do local c=vim.lsp.get_client_by_id(v.client_id); c:notify(\"workspace/didChangeConfiguration\",{}); local r=c:request_sync(\"view/resync\",{viewId=v.id},2000); assert(r and not r.err); return true end end)()')"
wait
goto "f.txt"
keys: Z
wait screen contains "Staged changes (1)"
expect screen contains "Unstaged changes (1)"
snapshot: repository-binding-staged
sh: test "$(git diff --cached --name-only)" = f.txt
