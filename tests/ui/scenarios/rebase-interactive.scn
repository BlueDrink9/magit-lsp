# Select an exclusive initial-rebase base, inspect the prepared plan, then discard it.
fixture: linear-rebase-history
---
sh: git rev-parse HEAD > .git/initial-head && git rev-parse HEAD~3 > .git/initial-base && git branch --show-current > .git/initial-branch && git ls-files --stage > .git/initial-index && git show-ref > .git/initial-refs && git diff --binary HEAD > .git/initial-worktree && test ! -d .git/rebase-merge && test ! -d .git/rebase-apply
keys: r
wait
expect view_stack.menus == 1
keys: i
wait screen contains "Log — initial rebase base"
expect view_stack.count == 2
sh: test "$(nvim --headless --server ../nvim.sock --remote-expr "line('.')")" = 3 && nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'three'
sh: nvim --headless --server ../nvim.sock --remote-expr "luaeval('vim.json.encode({mode=vim.api.nvim_get_mode().mode,name=vim.api.nvim_buf_get_name(0),cursor=vim.api.nvim_win_get_cursor(0),down=vim.fn.maparg(\"<Down>\",\"n\",false,true),render=require(\"magit-lsp.debug\").snapshot().render})')" > .git/native-selector-state && grep -q '"mode":"n"' .git/native-selector-state && grep -q 'magit://log/v1:log' .git/native-selector-state && grep -q '"down":{}' .git/native-selector-state
keys: Down
wait
sh: test "$(nvim --headless --server ../nvim.sock --remote-expr "line('.')")" = 4 && nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'two'
keys: Down
wait
sh: test "$(nvim --headless --server ../nvim.sock --remote-expr "line('.')")" = 5 && nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'one'
keys: Down
wait
sh: test "$(nvim --headless --server ../nvim.sock --remote-expr "line('.')")" = 6 && nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'base'
keys: Enter
wait screen contains "magit://rebase-todo/v1:rebase-todo"
expect view_stack.count == 2
sh: printf 'pick %s one\npick %s two\npick %s three\n' "$(git rev-parse --short=12 HEAD~2)" "$(git rev-parse --short=12 HEAD~1)" "$(git rev-parse --short=12 HEAD)" > .git/prepared-expected && nvim --headless --server ../nvim.sock --remote-expr "writefile(getline(1,'$'), '.git/prepared-actual')" >/dev/null && cmp .git/prepared-expected .git/prepared-actual && ! grep -Ev '^[a-z]+ [0-9a-f]{12} (one|two|three)$' .git/prepared-actual
keys: Escape
wait screen contains "Unstaged changes"
keys: r
wait
expect view_stack.menus == 1
keys: i
wait screen contains "Log — initial rebase base"
expect view_stack.count == 2
keys: Down
wait
keys: Down
wait
keys: Down
wait
sh: test "$(nvim --headless --server ../nvim.sock --remote-expr "line('.')")" = 6 && nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'base'
keys: Enter
wait screen contains "magit://rebase-todo/v1:rebase-todo"
expect view_stack.count == 2
sh: test "$(nvim --headless --server ../nvim.sock --remote-expr "line('.')")" = 1 && nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'one'
keys: J
wait
sh: nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'one'
keys: Down
wait
sh: nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'three'
keys: d
wait
sh: nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q '^drop '
sh: printf 'pick %s two\npick %s one\ndrop %s three\n' "$(git rev-parse --short=12 HEAD~1)" "$(git rev-parse --short=12 HEAD~2)" "$(git rev-parse --short=12 HEAD)" > .git/prepared-edited-expected && nvim --headless --server ../nvim.sock --remote-expr "writefile(getline(1,'$'), '.git/prepared-edited-actual')" >/dev/null && cmp .git/prepared-edited-expected .git/prepared-edited-actual
keys: Escape
wait screen contains "Unstaged changes"
expect view_stack.count == 1
keys: r
wait
expect view_stack.menus == 1
keys: Escape
wait screen contains "Unstaged changes"
keys: r
wait
expect view_stack.menus == 1
keys: i
wait screen contains "Log — initial rebase base"
expect view_stack.count == 2
keys: Down
wait
keys: Down
wait
keys: Down
wait
sh: test "$(nvim --headless --server ../nvim.sock --remote-expr "line('.')")" = 6 && nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'base'
keys: Enter
wait screen contains "magit://rebase-todo/v1:rebase-todo"
expect view_stack.count == 2
keys: J
wait
sh: nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'one'
keys: Down
wait
sh: nvim --headless --server ../nvim.sock --remote-expr "getline('.')" | grep -q 'three'
keys: d
wait
sh: printf 'pick %s two\npick %s one\ndrop %s three\n' "$(git rev-parse --short=12 HEAD~1)" "$(git rev-parse --short=12 HEAD~2)" "$(git rev-parse --short=12 HEAD)" > .git/prepared-submit-expected && nvim --headless --server ../nvim.sock --remote-expr "writefile(getline(1,'$'), '.git/prepared-submit-actual')" >/dev/null && cmp .git/prepared-submit-expected .git/prepared-submit-actual
keys: C-s
wait screen contains "Unstaged changes"
expect view_stack.count == 1
sh: git log --format=%s --reverse "$(cat .git/initial-base)..HEAD" > .git/actual-history && printf 'two\none\n' > .git/expected-history && cmp .git/expected-history .git/actual-history
sh: test "$(git show HEAD:one)" = "one" && test "$(git show HEAD~1:two)" = "two" && ! git cat-file -e HEAD:three
sh: test -z "$(git status --porcelain)"
sh: test ! -d .git/rebase-merge && test ! -d .git/rebase-apply
sh: test "$(git rev-parse HEAD~2)" = "$(cat .git/initial-base)"
sh: git rev-parse HEAD > .git/launched-head && git branch --show-current > .git/launched-branch && git show-ref > .git/launched-refs && git ls-files --stage > .git/launched-index && git diff --binary HEAD > .git/launched-worktree
keys: r
wait
expect view_stack.menus == 1
keys: Escape
wait screen contains "Unstaged changes"
expect view_stack.count == 1
expect view_stack.count == 1
expect view_stack.count == 1
sh: test "$(git rev-parse HEAD)" = "$(cat .git/launched-head)" && test "$(git branch --show-current)" = "$(cat .git/launched-branch)" && git show-ref > .git/launched-refs-after && cmp .git/launched-refs .git/launched-refs-after && git ls-files --stage > .git/launched-index-after && cmp .git/launched-index .git/launched-index-after && git diff --binary HEAD > .git/launched-worktree-after && cmp .git/launched-worktree .git/launched-worktree-after && test -z "$(git status --porcelain)" && test ! -d .git/rebase-merge && test ! -d .git/rebase-apply
keys: r
wait
expect view_stack.menus == 1
keys: Escape
wait screen contains "Unstaged changes"
