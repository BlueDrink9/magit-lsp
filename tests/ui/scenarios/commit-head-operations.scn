# Native commit-menu HEAD operations; each case checkpoints its own Git state.
fixture: staged-one-file
---
# A real parent, exact body and a prior date distinct from the worker clock.
sh: GIT_COMMITTER_DATE='2001-01-01T00:00:00+0000' git -c core.editor=true commit -m 'Native HEAD baseline' -m 'Exact retained body.' >/dev/null && git rev-parse HEAD > .git/baseline && printf '\nstaged amend sentinel\n' >> f.txt && git add f.txt
# Staged Amend: keep Git's original message intact.
sh: git rev-parse HEAD > .git/before; git rev-list --count HEAD > .git/count; git log -1 --format=%P > .git/parents; git write-tree > .git/head-index; git hash-object f.txt > .git/worktree; git log -1 --format=%B > .git/message
keys standard: g
keys vim: g r
wait
keys: :vsplit Enter
keys: c
wait screen contains "Reword"
snapshot: amend-menu
keys: a
wait screen contains "Exact retained body."
snapshot: amend-staged-draft
keys: :write Enter
keys: :q Enter
wait screen contains "Committed"
wait
snapshot: amend-staged-unchanged
sh: git log -1 --format=%B > .git/actual-message; cmp .git/message .git/actual-message && test "$(git log -1 --format=%T)" = "$(cat .git/head-index)" && test "$(git log -1 --format=%P)" = "$(cat .git/parents)" && test "$(git write-tree)" = "$(cat .git/head-index)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test "$(git rev-list --count HEAD)" = "$(cat .git/count)" && test "$(git rev-parse HEAD)" != "$(cat .git/before)" && test -z "$(git status --porcelain)"
# Clean unchanged Amend is also legal.
sh: git reset --hard "$(cat .git/baseline)" >/dev/null && git rev-parse HEAD > .git/before && git write-tree > .git/head-index && git hash-object f.txt > .git/worktree && test -z "$(git status --porcelain)"
keys standard: g
keys vim: g r
wait
keys: :vsplit Enter
keys: c
wait screen contains "Reword"
keys: a
wait screen contains "Exact retained body."
snapshot: amend-clean-draft
keys: :write Enter
keys: :q Enter
wait screen contains "Committed"
wait
snapshot: amend-clean-unchanged
sh: git log -1 --format=%B > .git/actual-message; cmp .git/message .git/actual-message && test "$(git log -1 --format=%T)" = "$(cat .git/head-index)" && test "$(git log -1 --format=%P)" = "$(cat .git/parents)" && test "$(git write-tree)" = "$(cat .git/head-index)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test "$(git rev-list --count HEAD)" = "$(cat .git/count)" && test "$(git rev-parse HEAD)" != "$(cat .git/before)" && test -z "$(git status --porcelain)"
# Reword must ignore an actually nonempty staged index.
sh: git reset --hard "$(cat .git/baseline)" >/dev/null && printf '\nstaged reword sentinel\n' >> f.txt && git add f.txt && git rev-parse HEAD > .git/before && git write-tree > .git/head-index && git log -1 --format=%T > .git/tree && git log -1 --format=%cI > .git/date && git hash-object f.txt > .git/worktree && test -n "$(git diff --cached --name-only)" && test "$(cat .git/head-index)" != "$(cat .git/tree)"
keys standard: g
keys vim: g r
wait
keys: :vsplit Enter
keys: c
wait screen contains "Reword"
keys: w
wait screen contains "Exact retained body."
keys: g g d G i "Native reworded message"
keys: Enter Enter "Exact edited body."
keys: Escape
keys: :write Enter
snapshot: reword-saved-draft
sh: test "$(git rev-parse HEAD)" = "$(cat .git/before)"
keys: :q Enter
wait screen contains "Committed"
wait
snapshot: reword-message
sh: printf 'Native reworded message\n\nExact edited body.\n\n' > .git/expected-message; git log -1 --format=%B > .git/actual-message; cmp .git/expected-message .git/actual-message && test "$(git log -1 --format=%T)" = "$(cat .git/tree)" && test "$(git log -1 --format=%cI)" = "$(cat .git/date)" && test "$(git write-tree)" = "$(cat .git/head-index)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test "$(git log -1 --format=%P)" = "$(cat .git/parents)" && test "$(git rev-list --count HEAD)" = "$(cat .git/count)" && test "$(git rev-parse HEAD)" != "$(cat .git/before)" && test -n "$(git diff --cached --name-only)"
# Staged Extend: no editor, exact original message and committer date.
sh: git reset --hard "$(cat .git/baseline)" >/dev/null && printf '\nextended\n' >> f.txt && git add f.txt && git rev-parse HEAD > .git/before && git write-tree > .git/head-index && git hash-object f.txt > .git/worktree
keys standard: g
keys vim: g r
wait
keys: c
wait screen contains "Reword"
keys: e
wait screen contains "Committed"
wait
expect screen not-contains "Please enter the commit message"
snapshot: extend-staged-no-editor
keys: ":lua assert(not require('magit-lsp.view').current().document)" Enter
sh: git log -1 --format=%B > .git/actual-message; cmp .git/message .git/actual-message && test "$(git log -1 --format=%cI)" = "$(cat .git/date)" && test "$(git log -1 --format=%T)" = "$(cat .git/head-index)" && test "$(git write-tree)" = "$(cat .git/head-index)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test "$(git log -1 --format=%P)" = "$(cat .git/parents)" && test "$(git rev-list --count HEAD)" = "$(cat .git/count)" && test "$(git rev-parse HEAD)" != "$(cat .git/before)" && test -z "$(git status --porcelain)"
# Capture --all in the menu: tracked edits are included, untracked are not.
sh: git reset --hard "$(cat .git/baseline)" >/dev/null && printf '\ntracked all\n' >> f.txt && printf 'untracked sentinel\n' > untracked.txt && git rev-parse HEAD > .git/before && git hash-object f.txt > .git/worktree && git hash-object untracked.txt > .git/untracked && git add -u && git write-tree > .git/expected-tree && git reset --quiet HEAD && test -z "$(git diff --cached --name-only)" && test -n "$(git diff --name-only)"
keys standard: g
keys vim: g r
wait
keys: c
wait screen contains "Reword"
keys: - a
wait
snapshot: extend-all-option
keys: e
wait screen contains "Committed"
wait
snapshot: extend-tracked-all
keys: ":lua assert(not require('magit-lsp.view').current().document)" Enter
sh: git log -1 --format=%B > .git/actual-message; cmp .git/message .git/actual-message && test "$(git log -1 --format=%cI)" = "$(cat .git/date)" && test "$(git log -1 --format=%T)" = "$(cat .git/expected-tree)" && test "$(git write-tree)" = "$(cat .git/expected-tree)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test "$(git hash-object untracked.txt)" = "$(cat .git/untracked)" && test -z "$(git ls-files -- untracked.txt)" && test "$(git status --porcelain)" = '?? untracked.txt' && test "$(git log -1 --format=%P)" = "$(cat .git/parents)" && test "$(git rev-list --count HEAD)" = "$(cat .git/count)" && test "$(git rev-parse HEAD)" != "$(cat .git/before)"
# Clean Extend guard, then --allow-empty permits an identical commit OID.
sh: rm untracked.txt && git reset --hard "$(cat .git/baseline)" >/dev/null && git rev-parse HEAD > .git/before && git write-tree > .git/head-index && git hash-object f.txt > .git/worktree && test -z "$(git status --porcelain)"
keys standard: g
keys vim: g r
wait
keys: c
wait screen contains "Reword"
keys: e
wait screen contains "Nothing staged (or unstaged) to extend"
snapshot: extend-clean-guard
sh: test "$(git rev-parse HEAD)" = "$(cat .git/before)" && test "$(git write-tree)" = "$(cat .git/head-index)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test -z "$(git status --porcelain)"
keys: c
wait screen contains "Reword"
keys: - e
wait
snapshot: extend-allow-empty-option
keys: e
wait screen contains "Committed"
wait
snapshot: extend-clean-allowed
keys: ":lua assert(not require('magit-lsp.view').current().document)" Enter
sh: test "$(git rev-parse HEAD)" = "$(cat .git/before)" && test "$(git write-tree)" = "$(cat .git/head-index)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test -z "$(git status --porcelain)"
# Explicit cancellation with staged AND unstaged changes preserves exact state.
sh: printf '\ncancel staged\n' >> f.txt && git add f.txt && printf '\ncancel unstaged\n' >> f.txt && git rev-parse HEAD > .git/before && git write-tree > .git/head-index && git hash-object f.txt > .git/worktree && git status --porcelain > .git/status
keys standard: g
keys vim: g r
wait
keys: c
wait screen contains "Reword"
keys: a
wait screen contains "Exact retained body."
keys: g g d G i "Explicitly cancelled amendment"
keys: Escape
snapshot: amend-cancel-draft
keys: ":lua require('magit-lsp.edit').cancel(require('magit-lsp.view').current().key)" Enter
wait screen contains "git commit"
sh: session=$(python3 -c 'import json; print(json.load(open("../state.json"))["tmux"])'); if tmux -L "$session" capture-pane -p -t magit | grep -Fq 'Press ENTER or type command to continue'; then tmux -L "$session" send-keys -t magit Enter; fi
wait
snapshot: amend-explicit-cancel
sh: git status --porcelain > .git/status-after; cmp .git/status .git/status-after && test "$(git rev-parse HEAD)" = "$(cat .git/before)" && test "$(git write-tree)" = "$(cat .git/head-index)" && test "$(git hash-object f.txt)" = "$(cat .git/worktree)" && test "$(git rev-list --count HEAD)" = "$(cat .git/count)"
expect no_message /E5108|Error executing lua|unexpected draft/
# Native reset-author Reword: retain a genuinely different staged index.
# The worker inherits the fixture's current author/date (Test User, 2000),
# not the historical commit's author/date (Historical Author, 1999).
sh: git reset --hard "$(cat .git/baseline)" >/dev/null && printf '\nreset-author content\n' >> f.txt && git add f.txt && GIT_AUTHOR_NAME='Historical Author' GIT_AUTHOR_EMAIL='old@example.com' GIT_AUTHOR_DATE='1999-02-03T04:05:06+0000' GIT_COMMITTER_DATE='2001-01-01T00:00:00+0000' git -c user.name='Historical Author' -c user.email='old@example.com' commit -qm 'Reset author baseline' && printf '\nreset-author staged sentinel\n' >> f.txt && git add f.txt
sh: python3 -c 'import json,subprocess; g=lambda *a: subprocess.check_output(["git",*a],text=True); fields={"head":["rev-parse","HEAD"],"message":["log","-1","--format=%B"],"author":["log","-1","--format=%an <%ae>"],"authorDate":["log","-1","--format=%at"],"tree":["log","-1","--format=%T"],"index":["write-tree"],"entries":["ls-files","--stage"],"parents":["log","-1","--format=%P"],"count":["rev-list","--count","HEAD"],"date":["log","-1","--format=%cI"],"worktree":["hash-object","f.txt"],"status":["status","--porcelain"]}; before={k:g(*v) for k,v in fields.items()}; assert before["tree"]!=before["index"], "reset-author fixture needs staged changes"; assert before["author"].strip()=="Historical Author <old@example.com>", "historical author fixture"; assert before["authorDate"].strip()=="918014706", "historical author date fixture"; identity,current=g("var","GIT_AUTHOR_IDENT").split(">"); json.dump({"fields":fields,"before":before,"identity":identity+">","currentAuthorDate":current.split()[0]},open(".git/reset-author-before.json","w"))'
keys standard: g
keys vim: g r
wait
keys: :vsplit Enter
keys: c
wait screen contains "Reword"
keys: - R
wait
snapshot: reset-author-option
keys: w
wait screen contains "Reset author baseline"
keys: :write Enter
sh: python3 -c 'import json,subprocess; b=json.load(open(".git/reset-author-before.json"))["before"]; assert subprocess.check_output(["git","rev-parse","HEAD"],text=True)==b["head"], "save alone must not replace HEAD"'
snapshot: reset-author-saved
keys: :q Enter
wait screen contains "Committed"
wait
snapshot: reset-author-result
sh: python3 -c 'import json,subprocess,pathlib; evidence=json.load(open(".git/reset-author-before.json")); before=evidence["before"]; after={k:subprocess.check_output(["git",*v],text=True) for k,v in evidence["fields"].items()}; evidence.update(after=after); state=json.load(open("../state.json")); output=pathlib.Path.cwd().parents[2]/"commit-head-operations"/(state["profile"]+"-"+str(state["cols"])+"x"+str(state["rows"]))/"reset-author-evidence.json"; json.dump(evidence,output.open("w"),indent=2); checks={**{k:(after[k],before[k]) for k in ("message","tree","index","entries","parents","count","date","worktree","status")},"current author":(after["author"].strip(),evidence["identity"]),"replaced HEAD":(after["head"]!=before["head"],True),"current author date":(after["authorDate"].strip(),evidence["currentAuthorDate"])}; failures=[f"{k}: actual={a!r}, expected={b!r}" for k,(a,b) in checks.items() if a!=b]; assert not failures, "reset-author Reword: " + "; ".join(failures)'
