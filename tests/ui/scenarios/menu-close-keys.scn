# Bug 3 regression: `q` and `Escape` each close an open menu.
fixture: modified-two-files
---
wait screen contains "+line3 CHANGED"
keys: m
wait
expect windows.floating == 1
keys: q
wait
expect windows.floating == 0
expect screen contains "Unstaged changes"
snapshot: q-closed
keys: m
wait
expect windows.floating == 1
keys: Escape
wait
expect windows.floating == 0
expect screen contains "Unstaged changes"
snapshot: escape-closed
