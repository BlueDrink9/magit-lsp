# Confirm the select-mode continuation: the copied commit id reaches the caller.
fixture: log-history
---
sh: nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "setreg('\"','sentinel')"
keys: l
wait screen contains "Log"
keys: c
wait screen contains "Select commit(s) to copy"
snapshot: select-picker
expect screen contains "old searchable subject"
keys: / "old searchable subject" Enter
wait
expect screen not-contains "Pattern not found"
keys: Enter
wait
expect screen contains "Unstaged changes"
expect view_stack.count == 1
snapshot: caller-restored
sh: test "$(nvim --headless --server "$MAGIT_LSP_UI_SOCKET" --remote-expr "getreg('\"')")" = "$(git rev-parse HEAD~2)"
sh: test -z "$(git status --porcelain)"
