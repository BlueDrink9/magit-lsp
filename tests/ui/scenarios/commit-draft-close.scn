# Native quit of a file while another real window keeps the editor alive.
# Last-window :q/:wq exits Neovim and cancels via shutdown, not confirmation.
fixture: staged-one-file
---
keys: :vsplit Enter
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: g g d G i "Native saved message"
keys: Escape
keys: :q Enter
wait screen contains "No write since last change"
snapshot: dirty-native-refusal
keys: ":lua local r=require('magit-lsp.view').current(); assert(r.document and vim.bo[r.buf].modified); print('Dirty draft retained')" Enter
wait screen contains "Dirty draft retained"
keys: :wq Enter
sh: session=$(python3 -c 'import json; print(json.load(open("../state.json"))["tmux"])'); if tmux -L "$session" capture-pane -p -t magit | grep -Fq 'Press ENTER or type command to continue'; then tmux -L "$session" send-keys -t magit Enter; fi
wait screen contains "Committed"
wait
snapshot: native-save-and-close
sh: test "$(git log -1 --format=%B)" = 'Native saved message'; printf '\nsecond\n' >> f.txt; git add f.txt
keys standard: g
keys vim: g r
wait
keys: :vsplit Enter
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: g g d G i "Prior checkpoint"
keys: Escape
keys: :write Enter
keys: g g d G i "Unsaved must not commit"
keys: Escape
snapshot: unsaved-after-checkpoint
keys: :q! Enter
wait screen contains "Committed"
wait
snapshot: native-discard-to-saved
sh: test "$(git log -1 --format=%B)" = 'Prior checkpoint'; printf '\nthird\n' >> f.txt; git add f.txt; git rev-parse HEAD > .git/close-before; git write-tree > .git/close-index; git hash-object f.txt > .git/close-worktree
keys standard: g
keys vim: g r
wait
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: i "Explicitly aborted"
keys: Escape
keys: ":lua local v=require('magit-lsp.view'); local r=v.current(); assert(r.previous_buf==v.views[r.base].buf, 'draft did not replace status'); assert(vim.api.nvim_buf_is_valid(r.previous_buf))" Enter
keys: ":lua require('magit-lsp.edit').cancel(require('magit-lsp.view').current().key)" Enter
wait screen contains "git commit"
sh: session=$(python3 -c 'import json; print(json.load(open("../state.json"))["tmux"])'); if tmux -L "$session" capture-pane -p -t magit | grep -Fq 'Press ENTER or type command to continue'; then tmux -L "$session" send-keys -t magit Enter; fi
wait
snapshot: explicitly-aborted
keys: ":lua local v=require('magit-lsp.view'); local r=v.status(); assert(vim.api.nvim_get_current_buf()==r.buf, vim.inspect({current=vim.api.nvim_get_current_buf(),status=r.buf,win=r.win,buffers=vim.api.nvim_list_bufs()})); print('Status restored')" Enter
wait screen contains "Status restored"
sh: test "$(git rev-parse HEAD)" = "$(cat .git/close-before)" && test "$(git write-tree)" = "$(cat .git/close-index)" && test "$(git hash-object f.txt)" = "$(cat .git/close-worktree)"
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: g g d G i "Recovered failed close"
keys: Escape
keys: :write Enter
sh: mv .git/COMMIT_EDITMSG .git/draft-original; printf 'sentinel\n' > .git/draft-sentinel; ln -s draft-sentinel .git/COMMIT_EDITMSG
keys: :bdelete Enter
wait screen contains "commit draft:"
snapshot: failed-close-retained
sh: session=$(python3 -c 'import json; print(json.load(open("../state.json"))["tmux"])'); if tmux -L "$session" capture-pane -p -t magit | grep -Fq 'Press ENTER or type command to continue'; then tmux -L "$session" send-keys -t magit Enter; fi
keys: ":lua local r=require('magit-lsp.view').current(); assert(r.document and r.sync_error and vim.bo[r.buf].modifiable and r.text=='Recovered failed close\n'); print('Recoverable draft retained')" Enter
wait screen contains "Recoverable draft retained"
snapshot: recovery-text
sh: test "$(git rev-parse HEAD)" = "$(cat .git/close-before)" && test "$(cat .git/draft-sentinel)" = sentinel; rm .git/COMMIT_EDITMSG; mv .git/draft-original .git/COMMIT_EDITMSG
keys: :write! Enter
keys: :bdelete Enter
wait screen contains "Committed"
wait
snapshot: recovered-close-committed
sh: test "$(git log -1 --format=%B)" = 'Recovered failed close' && test "$(git rev-list --count HEAD)" = 4 && test -z "$(git status --porcelain)"
expect no_message /E5108|Error executing lua|unexpected draft/
