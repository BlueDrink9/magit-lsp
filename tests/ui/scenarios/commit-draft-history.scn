# Server-owned ring: recall both entries and restore the exact unsent draft.
fixture: staged-one-file
---
sh: git rev-parse HEAD > .git/history-before
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: g g d G i "First retained β"
keys: Escape
keys: :write Enter
keys: ":lua local r=require('magit-lsp.view').current(); assert(vim.wait(2000,function() return not r.busy end,10)); assert(not r.sync_error and r.saved_text=='First retained β\n' and not vim.bo[r.buf].modified); print('Checkpoint stays editing')" Enter
wait screen contains "Checkpoint stays editing"
sh: session=$(python3 -c 'import json; print(json.load(open("../state.json"))["tmux"])'); if tmux -L "$session" capture-pane -p -t magit | grep -Fq 'Press ENTER or type command to continue'; then tmux -L "$session" send-keys -t magit Enter; fi
snapshot: saved-stays-editing
sh: test "$(git rev-parse HEAD)" = "$(cat .git/history-before)"
keys standard: C-Enter
keys vim: Z Z
wait screen contains "Committed"
wait
sh: test "$(git log -1 --format=%B)" = 'First retained β'; printf '\nsecond\n' >> f.txt; git add f.txt
keys standard: g
keys vim: g r
wait
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: g g d G i "Second retained"
keys: Escape
keys standard: C-Enter
keys vim: Z Z
wait screen contains "Committed"
wait
sh: test "$(git log -1 --format=%B)" = 'Second retained'; printf '\nthird\n' >> f.txt; git add f.txt; git rev-parse HEAD > .git/history-browse-before
keys standard: g
keys vim: g r
wait
keys: c
wait
keys: c
wait screen contains "Please enter the commit message"
keys: g g d G i "Current unsent λ"
keys: Escape
# The driver's named-key grammar lacks M-Up/M-Down; tmux supplies real native
# modified arrows directly, without injecting editor APIs or changing mappings.
sh: python3 -c 'import json,subprocess; s=json.load(open("../state.json")); s["profile"] != "standard" or subprocess.run(["tmux","-L",s["tmux"],"send-keys","-t","magit","M-Up"],check=True)'
keys vim: [ m
wait screen contains "Second retained"
snapshot: recalled-newest
sh: python3 -c 'import json,subprocess; s=json.load(open("../state.json")); s["profile"] != "standard" or subprocess.run(["tmux","-L",s["tmux"],"send-keys","-t","magit","M-Up"],check=True)'
keys vim: [ m
wait screen contains "First retained β"
snapshot: recalled-older
sh: python3 -c 'import json,subprocess; s=json.load(open("../state.json")); s["profile"] != "standard" or subprocess.run(["tmux","-L",s["tmux"],"send-keys","-t","magit","M-Down"],check=True)'
keys vim: ] m
wait screen contains "Second retained"
sh: python3 -c 'import json,subprocess; s=json.load(open("../state.json")); s["profile"] != "standard" or subprocess.run(["tmux","-L",s["tmux"],"send-keys","-t","magit","M-Down"],check=True)'
keys vim: ] m
wait screen contains "Current unsent λ"
snapshot: restored-current
keys: ":lua local r=require('magit-lsp.view').current(); assert(not r.busy and not r.sync_error and r.text=='Current unsent λ\n' and r.saved_version==1 and vim.bo[r.buf].modified); local d=require('magit-lsp.debug').snapshot().drafts; assert(#d==1 and d[1].version==r.version and d[1].savedVersion==1)" Enter
sh: test "$(git rev-parse HEAD)" = "$(cat .git/history-browse-before)"
keys standard: C-Enter
keys vim: Z Z
wait screen contains "Committed"
wait
expect screen contains "Staged changes (0)"
snapshot: committed-current
sh: test "$(git log -1 --format=%B)" = 'Current unsent λ' && test "$(git rev-list --count HEAD)" = 4 && test -z "$(git status --porcelain)"
expect no_message /E5108|Error executing lua|unexpected draft/
