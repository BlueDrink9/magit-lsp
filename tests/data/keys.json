    "Insert",
    "Home",
    "End",
    "PageUp",
    "PageDown",
    "ArrowUp",
    "ArrowDown",
    "ArrowLeft",
    "ArrowRight",
    "F1",
    "F5",
    "F12",
    "ctrl+c",
    "ctrl+Enter",
    "ctrl+shift+c",
    "alt+ArrowDown",
    "meta+PageUp",
    "Space",
    "Plus",
    "ctrl+Plus",
    "g g",
    "z a",
    "] ]",
    "g r",
    "ctrl+k ctrl+s"
  ],
  "toNeovim": [
    ["s", "s"],
    ["S", "S"],
    ["?", "?"],
    ["%", "%"],
    ["$", "$"],
    ["!", "!"],
    ["-", "-"],
    ["=", "="],
    ["Enter", "<CR>"],
    ["Escape", "<Esc>"],
    ["Tab", "<Tab>"],
    ["shift+Tab", "<S-Tab>"],
    ["Delete", "<Del>"],
    ["Backspace", "<BS>"],
    ["Insert", "<Insert>"],
    ["Home", "<Home>"],
    ["End", "<End>"],
    ["PageUp", "<PageUp>"],
    ["PageDown", "<PageDown>"],
    ["ArrowUp", "<Up>"],
    ["ArrowDown", "<Down>"],
    ["ArrowLeft", "<Left>"],
    ["ArrowRight", "<Right>"],
    ["F1", "<F1>"],
    ["F5", "<F5>"],
    ["F12", "<F12>"],
    ["ctrl+c", "<C-c>"],
    ["ctrl+Enter", "<C-CR>"],
    ["ctrl+shift+c", "<C-S-c>"],
    ["alt+ArrowDown", "<A-Down>"],
    ["meta+PageUp", "<M-PageUp>"],
    ["Space", "<Space>"],
