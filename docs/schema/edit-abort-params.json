{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Run-aware abort intent for an attached commit draft.",
  "properties": {
    "command": {
      "description": "Semantic command; only common.cancel is accepted by this dispatcher.",
      "type": "string"
    },
    "runId": {
      "description": "Server-issued run identity.",
      "type": "string"
    },
    "uri": {
      "description": "Exact server-issued draft URI.",
      "type": "string"
    },
    "version": {
      "description": "Exact open synchronized document version.",
      "format": "int32",
      "type": "integer"
    }
  },
  "required": [
    "command",
    "runId",
    "uri",
    "version"
  ],
  "title": "EditAbortParams",
  "type": "object"
}
