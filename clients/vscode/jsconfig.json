{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node", "vscode"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["extension.js", "lib/**/*.js", "test/types.js"]
}
